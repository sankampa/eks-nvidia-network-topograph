# Template: Worker kubeconfig for MultiKueue
# Generated by: ./scripts/create-multikueue-kubeconfig.sh worker-B.kubeconfig
# Run that script against your WORKER cluster to produce a real kubeconfig.
# DO NOT commit real tokens to version control.
apiVersion: v1
kind: Config
clusters:
  - name: worker
    cluster:
      server: https://<WORKER_CLUSTER_API_ENDPOINT>
      certificate-authority-data: <BASE64_CA_DATA>
contexts:
  - name: worker
    context:
      cluster: worker
      user: multikueue-sa
current-context: worker
users:
  - name: multikueue-sa
    user:
      token: <SA_TOKEN_GENERATED_BY_SCRIPT>
